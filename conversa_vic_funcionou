# MAGIC %md
# MAGIC # Carga: `fat_conversa_vic`
# MAGIC
# MAGIC **Origem:** `bbts_amazon_connect.analysis.chat` +
# MAGIC `bbts_amazon_connect.connect_bbts_cobranca.chattranscripts` + `bbts_prdim.pessoa.pessoa`
# MAGIC
# MAGIC **Destino:** `{catalogo}.trusted.fat_conversa_vic`
# MAGIC
# MAGIC **Grão:** um contato (`ContactId` do Amazon Connect).
# MAGIC
# MAGIC **Estratégia:** `merge_dinamico` (SCD2), com o conjunto completo em cada execução.
# MAGIC
# MAGIC ## Decisões desta carga
# MAGIC
# MAGIC - **As duas origens são unidas, e isso não é redundância.** Elas são amostras
# MAGIC   **sobrepostas**: 69 `ContactId` em comum, 23 só em `analysis.chat`, 23 só em
# MAGIC   `chattranscripts` — universo real de **115 contatos**, não 92. Ler só a tabela de
# MAGIC   análise perderia 20% do universo e subestimaria toda taxa do relatório.
# MAGIC - **Os 23 ausentes da análise são contatos que nunca viraram diálogo:** 18 só exibiram um
# MAGIC   template `ViewResource` e 5 receberam a mensagem de fora do horário comercial. O Contact
# MAGIC   Lens não gera análise para contato sem conversa, e é por isso que eles faltam lá. Viram
# MAGIC   os desfechos `Sem interação do cliente` e `Fora do horário de atendimento`.
# MAGIC - **`analysis.chat` tem precedência no union**, porque carrega sentimento, resumos e
# MAGIC   tempos de resposta. `in_analise_contact_lens` marca quem tem esses campos; nos outros
# MAGIC   eles ficam nulos, que é a informação correta — não houve análise, não é "sentimento zero".
# MAGIC - **Sem filtro `in_registro_ativo` na origem.** Nenhuma das duas tem colunas de controle
# MAGIC   SCD2 — são ingestão direta do S3, particionadas por `year/month/day` de carga. A
# MAGIC   deduplicação é pelo `ContactId`, mantendo a partição mais recente.
# MAGIC - **Data da conversa vem da transcrição, não da partição.** A partição é data de carga:
# MAGIC   na amostra atual, conversas de junho a setembro chegaram todas em `day=11` de setembro.
# MAGIC   Usar a partição colocaria o relatório inteiro num único dia.
# MAGIC - **Desfecho híbrido.** Marcador estrutural decide o que é inequívoco; a IA decide o
# MAGIC   residual e os motivos. Ver a justificativa no topo de `_helpers`.
# MAGIC - **`cd_contato_inicial_connect` permite agrupar a jornada.** Para contato transferido
# MAGIC   entre fluxos, o Connect cria novo `ContactId` apontando para o inicial. Hoje os dois são
# MAGIC   sempre iguais na amostra, mas sem a coluna o vínculo seria irrecuperável depois.

# COMMAND ----------

# DBTITLE 1,Shared UC
# MAGIC %run /Shared/uc

# COMMAND ----------

# DBTITLE 1,Helpers do projeto
# MAGIC %run ../_helpers_funcionou

# COMMAND ----------

from pyspark.sql.functions import array_max, array_min, coalesce, col, lit,  row_number, size, to_date, to_timestamp, unix_timestamp, to_timestamp
from pyspark.sql.functions import dayofmonth, month, year, current_date
from pyspark.sql.window import Window

# COMMAND ----------

# DBTITLE 1,Configuração
from pyspark.sql.functions import (
    array_max,
    array_min,
    coalesce,
    col,
    lit,
    row_number,
    size,
    to_date,
    to_timestamp,
    unix_timestamp,
)
from pyspark.sql.window import Window

catalogo_connect = uc_catalog_name("bbts_amazon_connect") # noqa
catalogo_prdim = uc_catalog_name("bbts_prdim") # noqa
catalogo_escrita = uc_catalog_name("cobranca") # noqa
schema_escrita = "trusted"
tabela_escrita = "fat_conversa_vic"

tabela_analise = f"{catalogo_connect}.analysis.chat"
tabela_transcricao = f"{catalogo_connect}.connect_bbts_cobranca.chattranscripts"
tabela_pessoa = f"{catalogo_prdim}.pessoa.pessoa"
tabela_destino = f"{catalogo_escrita}.{schema_escrita}.{tabela_escrita}"

print(f"Origem analise:    {tabela_analise}")
print(f"Origem transcricao: {tabela_transcricao}")
print(f"Origem pessoa:     {tabela_pessoa}")
print(f"Destino:           {tabela_destino}")

# COMMAND ----------

# DBTITLE 1,Ler a análise do Contact Lens
# Campos aninhados são achatados aqui para que o union com a transcrição bruta, que não os tem,
# funcione por nome de coluna.
df_analise = spark.table(tabela_analise).filter(
    to_date(col("ts_modificacao_arquivo")) == current_date()
).select(
    col("CustomerMetadata.ContactId").alias("cd_contato_connect"),
    col("Transcript"),
    col("ConversationCharacteristics.ResponseTime.AutomatedInteractionGreetingTimeMillis").alias("te_saudacao_assistente_milissegundo"),
    col("ConversationCharacteristics.ResponseTime.DetailsByParticipantRole.CUSTOMER.Average.ValueMillis").alias("te_resposta_media_cliente_milissegundo"),
    col("ConversationCharacteristics.Sentiment.OverallSentiment.DetailsByParticipantRole.CUSTOMER").alias("vl_sentimento_cliente"),
    col("ConversationCharacteristics.ContactSummary.AutomatedInteractionSummary.Content").alias("tx_resumo_automatico"),
    col("ConversationCharacteristics.ContactSummary.PostContactSummary.Content").alias("tx_resumo_pos_contato"),
    lit(True).alias("in_analise_contact_lens"),
    col("Transcript.AbsoluteTime").alias("year"),
    col("Transcript.AbsoluteTime").alias("month"),
    col("Transcript.AbsoluteTime").alias("day"),
)

# COMMAND ----------

df_analise = df_analise.withColumn(
    "year", year(array_min(col("year")))
).withColumn(
    "month", month(array_min(col("month")))
).withColumn(
    "day", dayofmonth(array_min(col("day")))
)

# COMMAND ----------

#As duas origens são amostras SOBREPOSTAS, não uma contida na outra: 69 ContactId em comum,
# 23 só em cada lado, totalizando 115 contatos. Ler apenas `analysis.chat` perderia 23
# contatos (20% do universo) e subestimaria toda taxa do relatório.
#
# Os 23 ausentes de `analysis.chat` são contatos que nunca viraram diálogo — 18 só exibiram um
# template `ViewResource` e 5 receberam a mensagem de fora do horário comercial. O Contact Lens
# não gera análise para eles, e é por isso que não estão na tabela de análise.
df_transcricao_bruta = spark.table(tabela_transcricao)

df_transcricao_faltante = df_transcricao_bruta.join(
    df_analise.select("cd_contato_connect"),
    df_transcricao_bruta["ContactId"] == df_analise["cd_contato_connect"],
    how="left_anti",
    ).select(
    col("ContactId").alias("cd_contato_connect"),
    col("Transcript"),
    lit(False).alias("in_analise_contact_lens"),
    col("Transcript.AbsoluteTime").alias("year"),
    col("Transcript.AbsoluteTime").alias("month"),
    col("Transcript.AbsoluteTime").alias("day"),
)
df_transcricao_faltante =  df_transcricao_faltante.withColumn(
    "year", year(array_min(col("year")))
).withColumn(
    "month", month(array_min(col("month")))
).withColumn(
    "day", dayofmonth(array_min(col("day"))))

# COMMAND ----------

# DBTITLE 1,Ler a transcrição bruta e completar o universo
# allowMissingColumns preenche com nulo os campos do Contact Lens que a transcrição bruta não
# tem. Nulo aqui é a informação correta: não houve análise, e não "sentimento zero".
df_chat_bruto = df_analise.unionByName(df_transcricao_faltante, allowMissingColumns=True)

qt_bruto = df_chat_bruto.count()

# Uma reingestão do mesmo dia traz o ContactId de novo. Vence a partição mais recente e, no
# empate, a linha que tem análise do Contact Lens.
janela_conversa = Window.partitionBy("cd_contato_connect").orderBy(
    col("year").desc(), col("month").desc(), col("day").desc(), col("in_analise_contact_lens").desc()
)

df_chat = df_chat_bruto.withColumn("_rn", row_number().over(janela_conversa)).filter(col("_rn") == 1).drop("_rn")

qt_conversa = df_chat.count()
qt_com_analise = df_chat.filter(col("in_analise_contact_lens")).count()
print(f"Contatos na origem: {qt_bruto:,} linhas -> {qt_conversa:,} ContactId distintos")
print(f"  com analise do Contact Lens: {qt_com_analise:,}")
print(f"  sem analise (contato sem dialogo): {qt_conversa - qt_com_analise:,}")

# COMMAND ----------

# DBTITLE 1,Resolver o contato inicial
# `InitialContactId` só existe em chattranscripts. Para contato transferido entre fluxos, o
# Connect cria um novo ContactId apontando para o inicial; guardar o vínculo permite reconstruir
# a jornada completa. Na amostra atual os dois são sempre iguais, então nada se perde hoje —
# mas sem a coluna o vínculo seria irrecuperável quando passar a divergir.
df_contato_inicial = df_transcricao_bruta.select(
    col("ContactId").alias("cd_contato_connect"),
    col("InitialContactId").cast("string").alias("cd_contato_inicial_connect"),
).dropDuplicates(["cd_contato_connect"])

# COMMAND ----------

# DBTITLE 1,Derivar tempos e volumes da transcrição
transcript = col("Transcript")

# array_min e array_max ignoram nulos, então um evento sem AbsoluteTime não zera o intervalo.
ts_primeira_entrada = array_min(transformar_array(transcript, lambda m: to_timestamp(m.AbsoluteTime)))
ts_ultima_entrada = array_max(transformar_array(transcript, lambda m: to_timestamp(m.AbsoluteTime)))


def qt_mensagem_por_papel(papel):
    """Conta mensagens de um papel, descartando eventos sem conteúdo."""
    return size(
        filtrar_array(transcript, lambda m: (m.Type == lit("MESSAGE")) & (m.ParticipantRole == lit(papel)))
    ).cast("bigint")


df_metrica = (
    df_chat.withColumn("ts_inicio_conversa", ts_primeira_entrada)
    .withColumn("ts_fim_conversa", ts_ultima_entrada)
    .withColumn("dt_conversa", to_date(col("ts_inicio_conversa")))
    .withColumn(
        "te_duracao_conversa_segundo",
        (unix_timestamp(col("ts_fim_conversa")) - unix_timestamp(col("ts_inicio_conversa"))).cast("bigint"),
    )
    .withColumn(
        "qt_mensagem_conversa",
        size(filtrar_array(transcript, lambda m: m.Type == lit("MESSAGE"))).cast("bigint"),
    )
    .withColumn("qt_mensagem_cliente", qt_mensagem_por_papel("CUSTOMER"))
    .withColumn("qt_mensagem_assistente", qt_mensagem_por_papel("SYSTEM"))
    .withColumn("qt_mensagem_atendente", qt_mensagem_por_papel("AGENT"))
    .withColumn("cd_cpf_cliente", extrair_cpf_cliente(transcript))
    .withColumn("in_cliente_identificado", col("cd_cpf_cliente").isNotNull())
    # Nomes de exibição: entram na fato porque são insumo da anonimização em
    # refined.rst_conversa_anonimizada_vic, que precisa saber quais palavras redigir.
    .withColumn("no_cliente_informado", extrair_nome_exibicao("CUSTOMER", transcript))
    .withColumn("no_atendente", extrair_nome_exibicao("AGENT", transcript))
)

# COMMAND ----------

# DBTITLE 1,Aplicar sinais determinísticos e classificar
df_sinais = adicionar_sinais_deterministicos(df_metrica)
df_sinais = df_sinais.withColumn("_tp_desfecho_deterministico", desfecho_deterministico())

# `Transcript` já foi consumido por todas as derivações e não vai para o destino. Descartar
# antes do cache evita manter em memória o array de mensagens inteiro, que é a coluna mais
# pesada da origem — irrelevante nas 115 linhas da amostra, decisivo em volume de produção.
# `_tx_prosa` também sai: os marcadores já foram avaliados e ela guarda a conversa inteira.
df_sinais = df_sinais.drop("Transcript", "_tx_prosa")

# Materializa antes da chamada ao modelo: sem isso o plano com ai_query pode ser reavaliado.
df_sinais = df_sinais.cache()

qt_deterministico = df_sinais.filter(col("_tp_desfecho_deterministico").isNotNull()).count()
print(f"Desfecho resolvido por marcador estrutural: {qt_deterministico:,} de {qt_conversa:,}")

df_classificacao = classificar_conversa(df_sinais, tabela_destino)

# COMMAND ----------

# DBTITLE 1,Resolver o cliente no CRM
# A mesma pessoa pode ter mais de um id_pessoa no CRM. Vence o cadastro atualizado mais
# recentemente, para que a escolha seja estável entre execuções.
janela_pessoa = Window.partitionBy("_cpf").orderBy(
    col("ts_ultima_atualizacao").desc_nulls_last(), col("id_pessoa").desc()
)

# Só os CPFs que apareceram em conversa interessam. O semi-join antes da janela evita
# ordenar as mais de 24 milhões de linhas de pessoa para aproveitar algumas dezenas.
df_cpf_conversa = df_sinais.select(col("cd_cpf_cliente").alias("_cpf")).filter(col("_cpf").isNotNull()).distinct()

df_pessoa = (
    spark.table(tabela_pessoa)
    .filter(col("cd_tipo_pessoa") == lit("PF"))
    .withColumn("_cpf", normalizar_cpf_crm("nu_cpf_cnpj_pessoa"))
    .filter(col("_cpf").isNotNull() & (col("_cpf") != lit("")))
    .join(df_cpf_conversa, on="_cpf", how="left_semi")
    .withColumn("_rn", row_number().over(janela_pessoa))
    .filter(col("_rn") == 1)
    .select(
        # Renomeado já aqui para permitir join por nome de coluna, sem referência ambígua
        # depois do primeiro join.
        col("_cpf").alias("cd_cpf_cliente"),
        col("id_pessoa").cast("bigint").alias("id_pessoa_crm"),
        col("nm_pessoa").cast("string").alias("no_cliente"),
    )
)

# COMMAND ----------

# DBTITLE 1,Montar o resultado
df_juntado = (
    df_sinais.join(df_classificacao, on="cd_contato_connect", how="left")
    .join(df_contato_inicial, on="cd_contato_connect", how="left")
    .join(df_pessoa, on="cd_cpf_cliente", how="left")
)

tp_desfecho = consolidar_desfecho(col("_tp_desfecho_deterministico"), col("tp_desfecho_ia"))

df_result = df_juntado.select(
    # identificação
    col("cd_contato_connect").cast("string"),
    # Quando o Connect não informa o contato inicial, o próprio contato é o inicial. Assim a
    # coluna nunca é nula e sempre serve para agrupar a jornada.
    coalesce(col("cd_contato_inicial_connect"), col("cd_contato_connect"))
    .cast("string")
    .alias("cd_contato_inicial_connect"),
    col("dt_conversa").cast("date"),
    col("ts_inicio_conversa").cast("timestamp"),
    col("ts_fim_conversa").cast("timestamp"),
    # cliente
    col("cd_cpf_cliente").cast("string"),
    col("id_pessoa_crm").cast("bigint"),
    col("no_cliente").cast("string"),
    col("no_cliente_informado").cast("string"),
    col("no_atendente").cast("string"),
    col("in_cliente_identificado").cast("boolean"),
    # desfecho e motivos
    tp_desfecho.cast("string").alias("tp_desfecho"),
    motivo_condicionado(tp_desfecho, DESFECHO_ABANDONO, col("tp_etapa_abandono_ia"))
    .cast("string")
    .alias("tp_etapa_abandono"),
    motivo_condicionado(tp_desfecho, DESFECHO_RECUSA, col("tp_motivo_recusa_ia"))
    .cast("string")
    .alias("tp_motivo_recusa"),
    motivo_condicionado(tp_desfecho, DESFECHO_TRANSFERIDO, col("tp_motivo_transferencia_ia"))
    .cast("string")
    .alias("tp_motivo_transferencia"),
    col("_tp_desfecho_deterministico").isNotNull().cast("boolean").alias("in_desfecho_deterministico"),
    # indicadores de percurso
    col("in_acordo_fechado").cast("boolean"),
    col("in_segunda_via_boleto").cast("boolean"),
    col("in_transferido_atendente").cast("boolean"),
    col("in_atendente_humano_presente").cast("boolean"),
    col("in_sem_divida").cast("boolean"),
    col("in_erro_tecnico").cast("boolean"),
    col("in_fora_horario_atendimento").cast("boolean"),
    col("in_sem_interacao_cliente").cast("boolean"),
    col("in_analise_contact_lens").cast("boolean"),
    # métricas de interação
    col("qt_mensagem_conversa").cast("bigint"),
    col("qt_mensagem_cliente").cast("bigint"),
    col("qt_mensagem_assistente").cast("bigint"),
    col("qt_mensagem_atendente").cast("bigint"),
    col("te_duracao_conversa_segundo").cast("bigint"),
    # Já achatadas na leitura da análise; nulas nos contatos sem Contact Lens.
    col("te_saudacao_assistente_milissegundo").cast("bigint"),
    col("te_resposta_media_cliente_milissegundo").cast("bigint"),
    col("vl_sentimento_cliente").cast("double"),
    # texto
    col("tx_resumo_automatico").cast("string"),
    col("tx_resumo_pos_contato").cast("string"),
    col("tx_justificativa_ia").cast("string").alias("tx_justificativa_desfecho"),
    # Diálogo cru, com dado pessoal. Fica na trusted, que é de uso interno, e é a origem da
    # versão redigida em refined.rst_conversa_anonimizada_vic. Nunca compartilhar esta coluna.
    col("_tx_dialogo").cast("string").alias("tx_dialogo"),
)

# COMMAND ----------

# DBTITLE 1,Validar
validar_unicidade(df_result, "cd_contato_connect", tabela_escrita)

validar_dominio(df_result, "tp_desfecho", DESFECHOS_VALIDOS, tabela_escrita)

# A chave é única por contato, mas o contato inicial pode repetir quando a jornada tem mais de
# um segmento. Só o alerta importa: valor repetido muda a leitura de "total de conversas".
qt_contato = df_result.count()
qt_jornada = df_result.select("cd_contato_inicial_connect").distinct().count()
if qt_jornada < qt_contato:
    print(f"  aviso: {qt_contato - qt_jornada:,} contatos sao segmento de jornada ja contada (contato inicial repetido)")
# SEM_CAUSA_CLARA entra no domínio das três taxonomias: é o rótulo residual aplicado por
# motivo_condicionado quando o modelo não informa motivo para um desfecho que exige um.
validar_dominio(
    df_result, "tp_etapa_abandono", list(MAPA_ETAPA_ABANDONO.values()), tabela_escrita
)
validar_dominio(
    df_result, "tp_motivo_recusa", list(MAPA_MOTIVO_RECUSA.values()) + [SEM_CAUSA_CLARA], tabela_escrita
)
validar_dominio(
    df_result,
    "tp_motivo_transferencia",
    list(MAPA_MOTIVO_TRANSFERENCIA.values()) + [SEM_CAUSA_CLARA],
    tabela_escrita,
)

# Cobertura das chaves de ligação com o CRM. Acompanhada entre cargas: queda brusca indica
# mudança no roteiro do assistente ou na ingestão, não comportamento do cliente.
qt_com_cpf = df_result.filter(col("cd_cpf_cliente").isNotNull()).count()
qt_com_pessoa = df_result.filter(col("id_pessoa_crm").isNotNull()).count()
print(f"  cobertura cd_cpf_cliente: {qt_com_cpf:,}/{qt_conversa:,} ({qt_com_cpf / qt_conversa:.1%})")
print(f"  cobertura id_pessoa_crm:  {qt_com_pessoa:,}/{qt_conversa:,} ({qt_com_pessoa / qt_conversa:.1%})")

print("  distribuicao por desfecho:")
for linha in df_result.groupBy("tp_desfecho").count().orderBy(col("count").desc()).collect():
    print(f"    {linha['tp_desfecho']}: {linha['count']:,}")

# COMMAND ----------

# DBTITLE 1,Gravar
merge_dinamico(catalogo_escrita, schema_escrita, tabela_escrita, df_result) # noqa

qt_ativo = spark.table(tabela_destino).filter(col("in_registro_ativo") == lit("Ativo")).count()
print(f"Carga concluida. Registros ativos em {tabela_escrita}: {qt_ativo:,}")

# COMMAND ----------

# DBTITLE 1,Liberar cache
df_sinais.unpersist()
df_classificacao.unpersist()
