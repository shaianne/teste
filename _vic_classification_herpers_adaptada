def sk_deterministica(*colunas):
    """Gera surrogate key estável a partir da chave natural.

    `monotonically_increasing_id()` não serve: o valor reinicia a cada execução, o hash do
    `merge_dinamico` muda sem mudança na origem e a tabela inteira é reinserida a cada
    carga. Derivar da chave natural também permite ao fato calcular a FK sem join.
    """
    partes = [coalesce(c.cast("string"), lit("")) for c in colunas]

    todas_nulas = colunas[0].isNull()
    for coluna in colunas[1:]:
        todas_nulas = todas_nulas & coluna.isNull()

    return when(todas_nulas, lit(None).cast("bigint")).otherwise(xxhash64(concat_ws("|", *partes)))


def sk_tempo(coluna_data):
    """Converte data ou timestamp na SK de dimensão tempo, no formato YYYYMMDD."""
    from pyspark.sql.functions import date_format

    return date_format(coluna_data, "yyyyMMdd").cast("bigint")


