    palavras = split(concat_ws(" ", *nomes_validos), r"[\s]+")

    limpas = transformar_array(palavras, lambda p: regexp_replace(p, r"[^a-zA-ZÀ-ÿ0-9]", ""))

    return array_distinct(
    filtrar_array(
        limpas,
        lambda p: (
            (length(p) >= lit(TAMANHO_MINIMO_TOKEN_NOME)) & ~lower(p).isin(*sorted(STOPWORD_NOME))
        ),
    )
)


def anonimizar_texto(coluna_texto, coluna_tokens_nome):
    """Redige dado pessoal do texto da conversa.

    Aplica primeiro os padrões estruturais de `PADRAO_REDACAO` e depois, palavra por palavra, os
    nomes de `coluna_tokens_nome`.

    A redação de nome usa `aggregate` sobre o array em vez de função definida pelo usuário: a
    lista de nomes varia por linha, e `aggregate` resolve isso no motor do Spark, sem o custo de
    serialização de uma UDF em Python.

    O limite de palavra `\\b` evita que um nome curto como "Ana" case dentro de "Analista".
    """
    texto_estrutural = coluna_texto
    for padrao, substituto in PADRAO_REDACAO:
        texto_estrutural = regexp_replace(texto_estrutural, padrao, substituto)

    return aggregate(
        coluna_tokens_nome,
        texto_estrutural,
        lambda acumulado, palavra: regexp_replace(
            acumulado, concat(lit(r"(?i)\b"), palavra, lit(r"\b")), lit("[NOME]")
        ),
    )


