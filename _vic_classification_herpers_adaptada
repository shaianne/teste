# DBTITLE 1,Sinais determinísticos do desfecho


def adicionar_sinais_deterministicos(df, coluna_transcript="Transcript"):
    """Deriva os indicadores de desfecho que têm marcador inequívoco na transcrição.

    Devolve o DataFrame acrescido de `_tx_prosa`, `_tx_dialogo` e das colunas `in_*`.
    As colunas com prefixo `_` são auxiliares e devem ser descartadas antes da gravação.

    Todo marcador de prosa é casado contra `_tx_prosa`, que exclui os payloads JSON de
    template — ver `texto_prosa`. A única exceção é o envio de documento, que é detectado
    justamente dentro do payload.
    """
    transcript = col(coluna_transcript)

    df_sinais = (
    df.withColumn("_tx_prosa", texto_prosa(transcript))
    .withColumn("_tx_dialogo", montar_dialogo(transcript))
    .withColumn("_in_documento_enviado", contem_template_documento(transcript))
    .withColumn(
        "_in_confirmacao_acordo",
        col("_tx_prosa").rlike(MARCADOR_CONFIRMACAO_ACORDO),
    )
    .withColumn(
        "_in_evento_transferencia",
        exists(
            transcript,
            lambda m: m.ContentType == lit(EVENTO_TRANSFERENCIA),
        ),
    )
    .withColumn(
    "in_atendente_humano_presente",
    expr(
        """
        exists(
            transcript,
            m -> m.ParticipantRole = 'AGENT'
                 AND m.Type = 'MESSAGE'
        )
        """
    ),
)
    .withColumn(
    "in_erro_tecnico",
    expr(
        f"""
        exists(
            transcript,
            m -> m.ContentType = '{EVENTO_FALHA_LEX}'
        )
        OR _tx_prosa RLIKE '{MARCADOR_ERRO_TECNICO}'
        """
    ),
)
    .withColumn(
        "in_sem_divida",
        col("_tx_prosa").rlike(MARCADOR_SEM_DIVIDA),
    )
    .withColumn(
        "in_fora_horario_atendimento",
        col("_tx_prosa").rlike(MARCADOR_FORA_HORARIO),
    )
    .withColumn(
        "in_sem_interacao_cliente",
        size(
            filtrar_array(
                transcript,
                lambda m: (
                    (m.Type == lit("MESSAGE")) & (m.ParticipantRole == lit("CUSTOMER"))
                ),
            )
        ) == lit(0),
    )
)

    # Acordo fechado exige as duas evidências. Documento sem texto de fechamento é segunda
    # via: na amostra são 6 dos 8 envios, e tratá-los como acordo quadruplicaria a taxa de
    # conversão informada ao negócio.
    df_sinais = (
        df_sinais.withColumn(
            "in_acordo_fechado",
            col("_in_documento_enviado") & col("_in_confirmacao_acordo"),
        )
        .withColumn(
            "in_segunda_via_boleto",
            col("_in_documento_enviado") & ~col("_in_confirmacao_acordo"),
        )
        .withColumn(
            "in_transferido_atendente",
            col("_in_evento_transferencia") | col("_tx_prosa").rlike(MARCADOR_TRANSFERENCIA),
        )
    )

    return df_sinais


def desfecho_deterministico():
    """Resolve o desfecho quando há marcador inequívoco; nulo quando cabe à IA decidir.

    A ordem não é arbitrária.

    **Ausência de interação vem primeiro.** Se o cliente não escreveu nada, nenhum desfecho
    pode ser atribuído ao comportamento dele — qualquer texto na transcrição é só roteiro do
    assistente. A exceção é o evento `transfer.succeeded`: um transbordo registrado pelo
    Connect aconteceu de fato, mesmo sem o cliente escrever.

    **Depois, do mais conclusivo para o menos.** Um acordo fechado continua sendo acordo
    fechado mesmo que a conversa depois passe por um atendente humano.

    **Fora do horário antes de nada mais textual**, porque é mensagem automática que encerra
    o atendimento antes de qualquer negociação.

    `in_atendente_humano_presente` de propósito **não** entra aqui. Na amostra, 22 conversas
    têm mensagem de atendente, mas o roteiro de encerramento por inatividade também é
    enviado por atendente ("Por falta de comunicação, o contato será encerrado"). Só o
    evento `transfer.succeeded` e o texto explícito de transferência caracterizam escalada.
    """
    return (
        when(
            expr(
                 "in_sem_interacao_cliente AND NOT _in_evento_transferencia"
                ),
                lit(DESFECHO_SEM_INTERACAO),
        )
        .when(col("in_acordo_fechado"), lit(DESFECHO_ACORDO_FECHADO))
        .when(col("in_segunda_via_boleto"), lit(DESFECHO_SEGUNDA_VIA))
        .when(col("in_transferido_atendente"), lit(DESFECHO_TRANSFERIDO))
        .when(col("in_sem_divida"), lit(DESFECHO_SEM_DIVIDA))
        .when(col("in_erro_tecnico"), lit(DESFECHO_ERRO_TECNICO))
        .when(col("in_fora_horario_atendimento"), lit(DESFECHO_FORA_HORARIO))
        .otherwise(lit(None).cast("string"))
    )


