# DBTITLE 1,Extração de campos da transcrição


def _e_payload_template(coluna_conteudo):
    """Indica se o conteúdo da mensagem é um payload JSON de template, e não conversa.

    Usa expressão regular em vez de `trim(...) LIKE '{%'` porque o `trim` do Spark remove
    apenas o caractere espaço, e **não** a quebra de linha. O template `WhatsAppDocument` vem
    com `\\n` antes da chave de abertura, então a versão com `trim` deixava passar justamente o
    payload que carrega a URL do boleto com nome do cliente e assinatura SAS.
    """
    return coluna_conteudo.rlike(r"^\s*\{")


def texto_prosa(coluna_transcript=col("Transcript")):
    """Concatena só o texto conversacional da transcrição, em minúsculas.

    **Descarta os payloads JSON de template.** O Connect envia templates (`ViewResource`,
    `WhatsAppDocument`) como conteúdo de mensagem, e dentro deles vão rótulos de menu da
    interface. Casar marcador de prosa nesse JSON produz falso positivo: medido na amostra,
    o template `ViewResource` contém o rótulo "falar com um atendente", o que classificava
    como transferido 2 contatos em que o cliente **nunca escreveu nada**.

    O corte é por chave de abertura no início do conteúdo, que separa payload de prosa sem
    depender de conhecer todos os tipos de template.

    As mensagens são separadas por ` || ` em vez de espaço para que um marcador não case
    acidentalmente atravessando a fronteira entre duas mensagens.
    """
    apenas_prosa = filtrar_array(
    coluna_transcript,
    lambda m: m.Content.isNotNull() & ~_e_payload_template(m.Content),
)
    return lower(
    concat_ws(" || ", transformar_array(apenas_prosa, lambda m: m.Content))
)


def contem_template_documento(coluna_transcript=col("Transcript")):
    """Indica se algum documento foi enviado ao cliente, olhando o payload do template.

    Complementa `texto_prosa`: a detecção do anexo precisa justamente do JSON que aquela
    função descarta. Por isso é estrutural, e não casamento de prosa.
    """
    return exists(
        coluna_transcript,
        lambda m: lower(coalesce(m.Content, lit(""))).contains(lit(TEMPLATE_DOCUMENTO_ENVIADO)),
    )


def montar_dialogo(coluna_transcript=col("Transcript"), limite_caracteres=700):
    """Monta o diálogo legível, usado no prompt da IA e como base da versão anonimizada.

    Mantém apenas mensagens (descarta eventos de entrada e saída de participante, que não
    carregam conteúdo) e prefixa cada linha com o papel: `SYSTEM` é o assistente VIC,
    `CUSTOMER` é o cliente e `AGENT` é o atendente humano.

    **Descarta os payloads JSON de template**, pela mesma regra de `texto_prosa`, e aqui a
    razão é mais forte. O template `ViewResource` carrega um bloco estruturado com nome
    completo, CPF e telefone do cliente, mais um `viewToken` de acesso:

        {"Label":"nome","Value":"Nathalia Almeida Andrade"},
        {"Label":"CPF","Value":"07116641530"},
        {"Label":"Telefone","Value":"558193770084"}

    Esse bloco não é conversa e não serve à avaliação de qualidade, mas escaparia da redação
    de nomes quando o cliente não tem `DisplayName` nem cadastro no CRM — justamente os casos
    em que não há de onde tirar a lista de palavras a redigir.

    Custo medido na amostra: 18 das 1.552 mensagens. Todas as 18 pertencem a contatos que não
    têm nenhuma mensagem de prosa, ou seja, contatos sem conversa a avaliar.
    """
    mensagens = filtrar_array(
        coluna_transcript,
        lambda m: (m.Type == lit("MESSAGE")) & m.Content.isNotNull() & ~_e_payload_template(m.Content),
    )
    return concat_ws(
        "\n",
        transformar_array(
            mensagens,
            lambda m: concat(m.ParticipantRole, lit(": "), substring(m.Content, 1, limite_caracteres)),
        ),
    )


def extrair_cpf_cliente(coluna_transcript=col("Transcript")):
    """Extrai o CPF que o cliente digitou no chat.

    Considera apenas mensagens do cliente cujo conteúdo, depois de remover tudo que não é
    dígito, tenha exatamente 11 posições. O critério é restritivo de propósito: valores
    monetários, números de parcela e datas também são dígitos, e um casamento frouxo
    ligaria a conversa ao CPF de outra pessoa.

    Devolve o primeiro CPF válido, ou nulo quando o cliente não se identificou — o que
    ocorre em 40 das 92 conversas da amostra.
    """
    candidatos = transformar_array(
        coluna_transcript,
        lambda m: when(
            (m.ParticipantRole == lit("CUSTOMER")) & (m.Type == lit("MESSAGE")),
            regexp_extract(regexp_replace(m.Content, "[^0-9]", ""), "^([0-9]{11})$", 1),
        ),
    )
    validos = filtrar_array(candidatos, lambda v: v.isNotNull() & (v != lit("")))

    # `try_element_at` e não `element_at`: com ANSI ligado, `element_at` sobre array vazio
    # lança INVALID_ARRAY_INDEX_IN_ELEMENT_AT em vez de devolver nulo. Array vazio é o caso
    # normal aqui, não a exceção — em 63 dos 115 contatos o cliente não informou CPF.
    return try_element_at(validos, lit(1))


def extrair_nome_exibicao(papel, coluna_transcript=col("Transcript")):
    """Extrai o nome de exibição de um papel na transcrição.

    Para `CUSTOMER` é o nome do perfil do WhatsApp, que costuma ser o nome real da pessoa —
    portanto é dado pessoal. Para `AGENT` é o nome do atendente, que é dado pessoal de
    colaborador. Ambos entram na lista de redação da versão anonimizada.

    Descarta os valores sintéticos do assistente (`BOT`, `SYSTEM_MESSAGE`).
    """
    nomes = filtrar_array(
        coluna_transcript,
        lambda m: (m.ParticipantRole == lit(papel))
            .__and__(m.DisplayName.isNotNull())
            .__and__(~m.DisplayName.isin("BOT", "SYSTEM_MESSAGE")),
    )

    return try_element_at(
        transformar_array(nomes, lambda m: m.DisplayName),
        lit(1),
    )


def normalizar_cpf_crm(coluna_cpf):
    """Normaliza o CPF do CRM para casar com o do chat.

    `bbts_prdim.pessoa.pessoa.nu_cpf_cnpj_pessoa` vem com 14 posições e zeros à esquerda
    (`00060384549934`), enquanto o cliente digita 11 (`60384549934`). O corte pelos 11
    dígitos finais alinha os dois e resolve 51 dos 52 CPFs da amostra.
    """
    return expr(f"right(regexp_replace({coluna_cpf}, '[^0-9]', ''), 11)")


