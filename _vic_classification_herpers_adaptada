# DBTITLE 1,Normalização do produto da dívida

# Grupos pedidos pelo negócio no item 3 do relatório, na ordem de avaliação. A ordem
# importa: `CH ESP CLASSIC` casa com "Cheque Especial" e com "Limite Classic", e
# `RENEGOCIACAO AUTOMATICA PF` casa com "Renegociação" e com "Crédito Automático". O
# primeiro padrão que casar vence, então o mais específico vem antes.
GRUPO_PRODUTO = [
    ("Ourocard", r"OUROCARD|PRIVATE LABEL"),
    # `CHEQUE ESP` e `CH OURO` são necessários além das grafias completas: a origem tem
    # `PARC CHEQUE ESP` e `CH OURO EMPRESARIAL`, que `CH ESP` e `CHEQUE OURO` não pegam.
    ("Cheque Especial", r"CH ESP|CHEQUE ESP|CH OURO|CHEQUE OURO"),
    ("Renegociação", r"RENEG"),
    # `CONSIG` cobre CONSIGNACAO, CONSIGNADO e a abreviação de `BB CONSIG-COMPRA DIV`.
    ("Crédito Consignado", r"CONSIG"),
    ("Crédito Renovação", r"RENOVACAO|RENOV "),
    ("Crédito Automático", r"AUTOMATICO"),
    ("Crédito Salário", r"SALARIO"),
    ("Crédito Benefício", r"BENEFICIO"),
    ("CDC", r"\bCDC\b|CREDIARIO"),
    ("Empréstimo Pessoal", r"EMPRESTIMO|MICROCREDITO"),
    ("Adiantamento a Depositantes", r"ADIANT"),
    ("Limite Classic", r"CLASSIC"),
]

GRUPO_PRODUTO_OUTROS = "Outros"


def normalizar_grupo_produto(coluna_produto):
    """Agrupa o produto bruto do CRM nos grupos de negócio do relatório.

    `bbts_prdim.divida.divida.tx_produto` não é padronizado: o mesmo produto aparece como
    `BB CRED. RENOVACAO` e `BB CREDITO RENOVACAO`, `CH ESP CLASSIC` e
    `CHEQUE ESPECIAL CLASSIC`. São mais de 40 grafias para cerca de 12 grupos reais.

    Fora do domínio conhecido devolve `Outros` em vez de nulo, para que o total por grupo
    feche com o total de acordos. `tx_produto_origem` preserva o valor bruto.
    """
    coluna_maiuscula = upper(coalesce(coluna_produto, lit("")))

    expressao = None
    for grupo, padrao in GRUPO_PRODUTO:
        condicao = coluna_maiuscula.rlike(padrao)
        expressao = when(condicao, lit(grupo)) if expressao is None else expressao.when(condicao, lit(grupo))

    return expressao.otherwise(lit(GRUPO_PRODUTO_OUTROS))


