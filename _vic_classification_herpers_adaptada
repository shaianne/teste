def _literal_sql(texto):
    """Converte texto Python em literal de string do Spark SQL.

    Necessário porque `ai_query` só existe como função SQL: o prompt tem de atravessar
    `expr()`. A quebra de linha vira a sequência de escape `\\n`, que o parser do Spark
    reconverte — literal multilinha dentro de `expr()` é frágil.
    """
    escapado = texto.replace("\\", "\\\\").replace("'", "''").replace("\n", "\\n")
    return f"'{escapado}'"


def _aplicar_mapa(coluna, mapa, valor_padrao):
    """Traduz o código ASCII devolvido pelo modelo no rótulo de negócio.

    Código fora do mapa cai em `valor_padrao` em vez de virar nulo: o `enum` do
    `responseFormat` já restringe o domínio, e um valor inesperado é sinal de mudança de
    contrato do endpoint, não de dado ausente.
    """
    expressao = None
    for codigo, rotulo in mapa.items():
        condicao = coluna == lit(codigo)
        expressao = when(condicao, lit(rotulo)) if expressao is None else expressao.when(condicao, lit(rotulo))
    return expressao.otherwise(lit(valor_padrao))


