# DBTITLE 1,Gate de PII residual

# Padrões que não podem sobrar no texto anonimizado. É a verificação de saída: as regras de
# redação podem falhar por grafia nova na origem, e este gate transforma isso em erro de carga
# em vez de vazamento silencioso para fora da empresa.
PADRAO_PII_PROIBIDO = [
    ("cpf", r"[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}"),
    ("sequencia_11_digitos", r"(^|[^0-9])[0-9]{11}([^0-9]|$)"),
    ("url", r"(?i)https?://"),
    ("token_assinado", r"(?i)[?&]sig="),
    ("email", r"(?i)[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}"),
    # Payload de template do Connect. Não deveria chegar aqui, porque montar_dialogo já o
    # descarta; o padrão fica como rede de segurança, já que o bloco traz nome, CPF e telefone
    # rotulados e um token de acesso.
    ("payload_template", r"(?i)(viewresource|viewtoken|templatetype)"),
]


def validar_ausencia_pii(df, coluna_texto, rotulo, colunas_proibidas=None):
    """Confere que o texto anonimizado não tem PII residual e que a tabela não tem coluna proibida.

    Falha alto de propósito. Esta é a última barreira antes de um dado sair da empresa: um aviso
    no log seria ignorado, e o custo do erro aqui é vazamento de dado pessoal de cliente.
    """
    colunas_atuais = set(df.columns)
    proibidas_presentes = sorted(colunas_atuais & set(colunas_proibidas or []))
    if proibidas_presentes:
        raise ValueError(
            f"{rotulo}: a tabela destinada a compartilhamento externo contem coluna identificadora: "
            f"{proibidas_presentes}. Remova do select."
        )

    achados = []
    for nome_padrao, padrao in PADRAO_PII_PROIBIDO:
        qt = df.filter(col(coluna_texto).isNotNull() & col(coluna_texto).rlike(padrao)).count()
        if qt > 0:
            achados.append(f"{nome_padrao}={qt}")

    if achados:
        exemplo = (
            df.filter(col(coluna_texto).rlike(PADRAO_PII_PROIBIDO[0][1]))
            .select(coluna_texto)
            .limit(1)
            .collect()
        )
        raise ValueError(
            f"{rotulo}: PII residual em {coluna_texto} apos anonimizacao: {', '.join(achados)}. "
            f"A carga foi interrompida para nao expor dado pessoal. "
            f"Revise PADRAO_REDACAO. Trecho de exemplo: {str(exemplo)[:200]}"
        )

    print(f"  {rotulo}: {coluna_texto} sem PII residual nos {len(PADRAO_PII_PROIBIDO)} padroes verificados")
