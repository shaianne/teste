def consolidar_desfecho(coluna_deterministico, coluna_desfecho_ia):
    """Combina o veredito determinístico com o da IA, com precedência do determinístico.

    Conversa vinda do cache cujo desfecho foi determinístico traz esse rótulo em
    `coluna_desfecho_ia`; como o determinístico é recalculado a cada carga e tem
    precedência, o resultado é o mesmo.
    """
    return coalesce(coluna_deterministico, coluna_desfecho_ia, lit(DESFECHO_NAO_CLASSIFICADO))


def motivo_condicionado(coluna_desfecho, desfecho_esperado, coluna_motivo, valor_residual=SEM_CAUSA_CLARA):
    """Só expõe o motivo quando ele é coerente com o desfecho final.

    Duas correções acontecem aqui, ambas observadas na amostra:

    1. O modelo preenche etapa de abandono em conversa que terminou em recusa. Sem o
       condicional, a soma por motivo não fecharia com a contagem do desfecho no relatório.
    2. O modelo devolve `NAO_APLICAVEL` para conversa cujo desfecho exige motivo. Nesse
       caso o valor vira `valor_residual`, para que a seção não exiba "Não aplicável" como
       fatia do gráfico.
    """
    motivo = coalesce(coluna_motivo, lit(NAO_APLICAVEL))
    motivo_ajustado = when(motivo == lit(NAO_APLICAVEL), lit(valor_residual)).otherwise(motivo)

    return when(coluna_desfecho == lit(desfecho_esperado), motivo_ajustado).otherwise(lit(NAO_APLICAVEL))


