def validar_dominio(
    df,
    coluna,
    valores_aceitos,
    rotulo,
):
    valores_invalidos = (
        df.filter(
            col(coluna).isNotNull()
        )
        .filter(
            ~col(coluna).isin(list(valores_aceitos))
        )
        .select(coluna)
        .distinct()
        .limit(5)
        .collect()
    )

    if valores_invalidos:
        exemplos = [
            linha[coluna]
            for linha in valores_invalidos
        ]

        raise ValueError(
            f"{rotulo}: {coluna} fora do domínio. "
            f"Exemplos: {exemplos}"
        )

    print(
        f"{rotulo}: {coluna} dentro do domínio "
        f"({len(valores_aceitos)} valores)"
    )

