def aplicar_comentarios(tabela_completa, table_comment, column_comments, spark=spark): # noqa
    """Aplica comentário de tabela e de colunas.

    `ddl_dinamico` cria e evolui a estrutura, mas não registra comentários, que são
    obrigatórios pelo AGENTS.md. Idempotente. Coluna do dicionário que não existe na tabela
    é ignorada com aviso, para que comentário desatualizado não derrube a DDL.
    """
    spark.sql(f"COMMENT ON TABLE {tabela_completa} IS '{table_comment.replace(chr(39), chr(39) * 2)}'")

    colunas_existentes = {linha["col_name"] for linha in spark.sql(f"DESCRIBE TABLE {tabela_completa}").collect()}

    qt_aplicado = 0
    for coluna, comentario in column_comments.items():
        if coluna not in colunas_existentes:
            print(f"  aviso: coluna {coluna} nao existe em {tabela_completa}, comentario ignorado")
            continue
        spark.sql(f"ALTER TABLE {tabela_completa} ALTER COLUMN {coluna} COMMENT '{comentario.replace(chr(39), chr(39) * 2)}'")
        qt_aplicado += 1

    print(f"  comentarios aplicados: 1 tabela + {qt_aplicado} colunas")


def validar_unicidade(df, chave, rotulo):
    """Confere que a chave de negócio é única antes da gravação.

    Falha alto: chave duplicada no fato multiplica valor em toda análise a jusante, e o erro
    é muito mais caro de achar depois da carga.
    """
    chaves = [chave] if isinstance(chave, str) else list(chave)

    qt_linha = df.count()
    qt_chave = df.select(*chaves).distinct().count()

    if qt_linha != qt_chave:
        raise ValueError(
            f"{rotulo}: chave {chaves} nao e unica — {qt_linha:,} linhas para "
            f"{qt_chave:,} chaves distintas ({qt_linha - qt_chave:,} duplicadas)"
        )

    print(f"  {rotulo}: {qt_linha:,} linhas, chave {chaves} unica")
    return qt_linha



