# DBTITLE 1,Pseudonimização

SCOPE_SEGREDO = "bbts"
CHAVE_SALT_PSEUDONIMO = "vic-connect-salt-pseudonimo"


def obter_salt(scope=SCOPE_SEGREDO, chave=CHAVE_SALT_PSEUDONIMO):
    """Lê o salt do secret scope.

    Falha alto quando o segredo não existe. O contrário — cair num salt padrão ou em string
    vazia — produziria pseudônimo reversível por tabela reversa sem nenhum aviso, que é
    exatamente o risco que esta função existe para evitar.

    Para criar o segredo uma única vez, pela CLI do Databricks:
        databricks secrets put-secret bbts vic-connect-salt-pseudonimo

    O valor deve ser aleatório, com pelo menos 32 bytes, e nunca versionado no repositório.
    """
    try:
        salt = dbutils.secrets.get(scope=scope, key=chave) # noqa
    except Exception as erro: # noqa
        raise ValueError(
            f"Segredo {scope}/{chave} nao encontrado. O pseudonimo NAO pode ser gerado sem salt: "
            f"sha2 de CPF sem salt e reversivel por tabela reversa. Crie o segredo antes de rodar. "
            f"Erro original: {str(erro).split(chr(10))[0]}"
        )

    if not salt or len(salt) < 16:
        raise ValueError(
            f"Segredo {scope}/{chave} vazio ou curto demais. Use valor aleatorio de 32 bytes ou mais."
        )

    return salt


def pseudonimo(coluna, salt, prefixo=""):
    """Gera pseudônimo estável e não reversível a partir de uma chave.

    Estável porque depende só do valor e do salt: a mesma pessoa recebe o mesmo pseudônimo em
    toda execução, o que permite contar contatos por cliente sem conhecer o cliente.

    O `prefixo` separa domínios: o pseudônimo de conversa e o de cliente derivados do mesmo
    texto não podem colidir, senão seria possível inferir relação entre eles.

    Devolve nulo quando a chave é nula — sem isso, todos os clientes não identificados
    receberiam o mesmo pseudônimo e pareceriam ser a mesma pessoa.
    """
    return when(
        coluna.isNotNull() & (coluna.cast("string") != lit("")),
        sha2(concat(lit(prefixo), lit(salt), coluna.cast("string")), 256),
    ).otherwise(lit(None).cast("string"))


